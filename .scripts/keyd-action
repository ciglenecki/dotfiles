# Run a command in a separate systemd user service.
#
# The command runs independently of the calling shell, with access to
# the graphical session and functions defined in ~/.scripts/alias.sh.
#
# Usage:
#   user_systemd_run COMMAND [ARGS...]      # Run a command with arguments
#   user_systemd_run -c 'SHELL_EXPRESSION'  # Execute shell syntax
#
# Examples:
#   user_systemd_run firefox
#   user_systemd_run firefox --private-window
#   user_systemd_run -c 'focuswindow Zotero || zotero'
#   user_systemd_run -c 'command1 && command2'
#
# Behavior:
#   - Starts a transient systemd user service.
#   - Passes graphical session environment variables.
#   - Appends stdout and stderr to ~/user_systemd_run.log.
#   - Loads aliases and functions from ~/.scripts/alias.sh.
#   - Supports shell operators (||, &&, |) through -c.
#
# Notes:
#   - Use -c only with trusted commands (it uses eval).
#   - Aliases require -c; shell functions work in both modes.
#   - The function returns the status of systemd-run, not the
#     final exit status of the launched command.


user_systemd_run() {
    systemd-run --user --collect \
        --setenv=DISPLAY="${DISPLAY:-:0}" \
        --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
        /bin/bash -c '
            exec >> "$HOME/user_systemd_run.log" 2>&1

            source "$HOME/.scripts/env.sh"

            shopt -s expand_aliases
            source "$HOME/.scripts/alias.sh"

            if [[ "$1" == "-c" ]]; then
                shift
                eval "$1"
            else
                "$@"
            fi
        ' bash "$@"
}




type_text() {
    printf '%s' "$1" | wl-copy --type text/plain || return 1
    # CTRL + SHIFT + V
    ydotool key 29:1 42:1 47:1 47:0 42:0 29:0 
}

type_file() {
    wl-copy --type text/plain < "$1" || return 1
    # CTRL + SHIFT + V
    ydotool key 29:1 42:1 47:1 47:0 42:0 29:0
}

